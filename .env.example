# Copy this file to .env and fill values locally.
# Never commit .env. Never paste this token into a hosted website.

# Personal dashboard auth mode. This is the cookie value from cursor.com:
# DevTools -> Application -> Cookies -> https://cursor.com -> WorkosCursorSessionToken
# Accepted formats:
#   user_abc%3A%3AeyJ...   (cookie value; best)
#   user_abc::eyJ...       (decoded cookie value)
#   eyJ...                 (raw JWT from local Cursor DB; the app tries to infer user id from sub)
CURSOR_SESSION_TOKEN=

# Optional: use official Team/Admin API instead of the unofficial personal dashboard API.
# Set CURSOR_AUTH_MODE=admin and CURSOR_ADMIN_API_KEY to use https://api.cursor.com/teams/filtered-usage-events.
# Cursor Admin API keys are not always available on individual plans.
CURSOR_AUTH_MODE=dashboard
CURSOR_ADMIN_API_KEY=

# Server binding. Keep HOST at 127.0.0.1 unless you really know what you are doing.
HOST=127.0.0.1
PORT=8787

# Endpoint tuning. Leave defaults unless DevTools shows Cursor changed paths.
CURSOR_WEB_BASE_URL=https://cursor.com
CURSOR_ADMIN_BASE_URL=https://api.cursor.com
POLL_DEFAULT_PAGE_SIZE=100
POLL_DEFAULT_MAX_PAGES=3
REQUEST_TIMEOUT_MS=30000

# Logging: debug, info, warn, error, or silent.
# Log output is JSON lines and redacts token-like values before writing.
LOG_LEVEL=info

# Safety: set to true to allow pasting/updating token from the web UI.
# Default false keeps bearer credentials out of browser JavaScript.
ALLOW_TOKEN_FROM_UI=false
